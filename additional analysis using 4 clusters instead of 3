# ── Step 6: Statistics ────────────────────────────────────────────────────────
cat("\n=== Chi-square on cluster proportions CSB vs WT ===\n")
csb_counts <- table(combined$cluster[combined$condition=="CSB"])
wt_counts  <- table(combined$cluster[combined$condition=="WT"])
count_mat  <- rbind(CSB=as.numeric(csb_counts), WT=as.numeric(wt_counts))
colnames(count_mat) <- names(csb_counts)
print(count_mat)
print(chisq.test(count_mat))

cat("\n=== Mann-Whitney U tests (CSB vs WT) per cluster ===\n")
shape_cols <- c("height","area","width.height.2","local.peaks","M.height")
results <- list()
for (cl in CLUSTER_LEVELS) {
  for (sc in shape_cols) {
    csb_v <- combined[[sc]][combined$cluster==cl & combined$condition=="CSB"]
    wt_v  <- combined[[sc]][combined$cluster==cl & combined$condition=="WT"]
    if (length(csb_v) > 0 && length(wt_v) > 0) {
      mw <- wilcox.test(csb_v, wt_v, alternative="two.sided")
      results[[length(results)+1]] <- data.frame(
        cluster=cl, index=sc, W=mw$statistic, p=mw$p.value,
        sig=ifelse(mw$p.value<0.001,"***",
                   ifelse(mw$p.value<0.01,"**",
                          ifelse(mw$p.value<0.05,"*","ns"))))
    }
  }
}
stats_df <- do.call(rbind, results)
rownames(stats_df) <- NULL
print(stats_df)
write.csv(stats_df,
          file.path(OUT_DIR, "k4_centroid_mannwhitney_results.csv"),
          row.names=FALSE)

