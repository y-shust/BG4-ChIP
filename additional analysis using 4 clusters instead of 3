# ── Helper: find optimal matching of 4 centroids to reference via brute force ──
best_match <- function(cand_centers, ref_centers_ordered) {
  perms <- matrix(c(
    1,2,3,4, 1,2,4,3, 1,3,2,4, 1,3,4,2, 1,4,2,3, 1,4,3,2,
    2,1,3,4, 2,1,4,3, 2,3,1,4, 2,3,4,1, 2,4,1,3, 2,4,3,1,
    3,1,2,4, 3,1,4,2, 3,2,1,4, 3,2,4,1, 3,4,1,2, 3,4,2,1,
    4,1,2,3, 4,1,3,2, 4,2,1,3, 4,2,3,1, 4,3,1,2, 4,3,2,1
  ), nrow=24, byrow=TRUE)

  best_cost <- Inf
  best_perm <- 1:4
  for (p in seq_len(nrow(perms))) {
    perm <- perms[p, ]
    cost <- sum(sapply(1:4, function(i) {
      sum((cand_centers[perm[i], ] - ref_centers_ordered[i, ])^2)
    }))
    if (cost < best_cost) {
      best_cost <- cost
      best_perm <- perm
    }
  }
  best_perm
}

