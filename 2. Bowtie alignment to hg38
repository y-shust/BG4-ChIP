#!/bin/bash
#PBS -lwalltime=08:00:00
#PBS -lselect=1:ncpus=8:mem=16gb

module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate Env

GENOME="/rds/general/project/diantonio/live/Yaryna/genome/hg38"

READDIR="/rds/general/project/diantonio/live/Yaryna/ChIP_WT"

THREADS=8

cd "$READDIR" || exit 1

for R1 in *_R1.fq.gz
do
# Derive R2 safely
    R2="${R1/_R1.fq.gz/_R2.fq.gz}"

    # Extract sample name
    SAMPLE="${R1/_R1.fq.gz/}"

    bowtie2 \
-p $THREADS \
        -x "$GENOME" \
        -1 "$R1" \
        -2 "$R2" \
        -S "${SAMPLE}.sam" \
        2> "${SAMPLE}.bowtie2.txt"
done
