python3 << 'EOF'
import csv
from collections import Counter

counts = Counter()
main_cats = ['promoter-TSS', 'intron', 'Intergenic', 'CpG', 'TTS', 'exon', "3' UTR", 'non-coding', "5' UTR"]

with open('annotated_CS1AN_CSB_BG4_Bio3_Multiinter_Min_Merged.bed') as f:
    reader = csv.reader(f, delimiter='\t')
    next(reader)
    for row in reader:
        ann = row[8].split(' (')[0]
        if ann in main_cats:
            counts[ann] += 1
        else:
            counts['Other (repeats/low complexity)'] += 1

for cat, n in counts.most_common():
    print(f"{cat}: {n}")
