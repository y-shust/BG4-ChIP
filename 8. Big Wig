#!/bin/bash
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=8:mem=16gb

# Load Conda
module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate deeptools_env

# Sample names
samples=("SRR15337931" "SRR15337932" "SRR15337936" "SRR15337938")

# Paths
projPath="/rds/general/project/diantonio/live/Silvia_Galli/winnie/align"
outDir="${projPath}/removeDuplicate/deduplicated/filteredTLEN1000"
bedPath="${outDir}/blacklist_filtered"
dtDir="${bedPath}/deepTools"

for s in "${samples[@]}"; do

    bam="${bedPath}/${s}.bl.dedup.sorted.bam"

    # bamCoverage tracks (background)
    bamCoverage -p 2 --normalizeUsing RPGC --effectiveGenomeSize 2700000000 -bs 5 -e \
        --minMappingQuality 20 -b "${bam}" -o "${dtDir}/${s}.hg38.uniq.bw"

done
