vim bamcoverage.pbs

#!/bin/bash
#PBS -lwalltime=08:00:00
#PBS -lselect=1:ncpus=8:mem=16gb

module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate deeptools_env

bam_dir=/rds/general/project/diantonio/live/Yaryna/ChIP_WT

for file in $bam_dir/*.bl.dedup.bam
do
name=`basename $file .bl.dedup.bam`
bamCoverage -p 2 --normalizeUsing RPGC --effectiveGenomeSize 2700000000 -bs 5 -e \
    --minMappingQuality 20 -b $file -o $bam_dir/${name}.hg38.uniq.bw
done
