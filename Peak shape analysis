conda activate sicchip_env

cd /rds/general/project/diantonio/live/Yaryna/SIC-ChIP

Rscript SIC-ChIP.r \
    --bw=/rds/general/project/diantonio/live/Yaryna/ChIP/Bio1/CS1AN_CSB_BG4_Bio1_Tech1.hg38.uniq.bw \
    --bed=/rds/general/project/diantonio/live/Yaryna/ChIP/Bio1/CS1AN_CSB_BG4_Bio1_Tech1_peaks.narrowPeak \
    --out=CSB_Bio1_Tech1_results \
    --N=10 \
    --toll=20

qsub run_sicchip_CSB_Bio1_Tech1.pbs
