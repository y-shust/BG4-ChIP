#!/bin/bash
#PBS -lwalltime=08:00:00
#PBS -lselect=1:ncpus=8:mem=16gb

module load miniforge/3
eval "$(~/miniforge3/bin/conda shell.bash hook)"
conda activate Env

fastqcpath="/rds/general/project/diantonio/live/Yaryna/ChIP"

for file in ${fastqcpath}/*.fq.gz
do
fastqc $file -o "$fastqcpath"
done

#to escape thiswindow:
#press esc , "insert" is gone (reversible by pressing i) , :wq, esc
# to come back, "vim name", "i"


# Did the file save correctly?
# - list contents again to confirm fastqc.pbs appeared
ls

# What does my job script actually contain?
# - print file contents to terminal
cat fastqc.pbs

# Submit the job to the PBS scheduler:
qsub fastqc.pbs

# - returns a job ID confirming submission, such as "2957516.pbs-7"      
# check the status of the job:
qstat 2957516.pbs-7  

